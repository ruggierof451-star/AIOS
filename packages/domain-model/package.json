{
  "name": "@aios/domain-model",
  "version": "0.1.0",
  "private": true,
  "description": "Tipi ed entità condivise del Domain Model AIOS. Nessuna logica di business qui — solo forma dei dati (vedi packages/README.md).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": "./prisma/schema.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "prisma migrate dev --name init",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "vitest": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
