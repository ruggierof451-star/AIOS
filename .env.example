# AIOS — Variabili d'ambiente (esempio)
# Copia questo file in .env e compila i valori per il tuo ambiente locale.
# Non committare mai il file .env reale (vedi .gitignore).

# ---------- Ambiente ----------
NODE_ENV=development
AIOS_ENV=local

# ---------- Database (Engineering Bible Modulo 6) ----------
DATABASE_URL=postgresql://aios:aios_dev_password@localhost:5432/aios_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---------- Cache / Session Store (Redis) ----------
REDIS_URL=redis://localhost:6379

# ---------- Event Bus (Redpanda in locale, Kafka-compatibile) ----------
KAFKA_BROKERS=localhost:9092

# ---------- Object Storage (MinIO in locale, S3-compatibile) ----------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=aios_dev
OBJECT_STORAGE_SECRET_KEY=aios_dev_password
OBJECT_STORAGE_BUCKET=aios-documents-dev

# ---------- Analytics Storage (ClickHouse) ----------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=aios_analytics_dev

# ---------- Comunicazione tra servizi (quando eseguiti nativamente via `pnpm dev`) ----------
# In questa modalità ogni servizio gira come processo locale su localhost,
# non nella rete Docker interna (dove userebbero i nomi dei container) —
# per questo qui le URL puntano tutte a localhost con la propria porta.
#
# NOTA IMPORTANTE: non impostare qui una variabile PORT condivisa — ogni
# servizio (identity, organization, workspace, administration, gateway)
# userebbe lo STESSO valore (dotenv-cli esporta questo file nell'ambiente
# di TUTTI i processi avviati da `pnpm dev`), causando un conflitto di
# porta tra loro. Ogni servizio ha già una porta di default distinta
# codificata nel proprio main.ts (3000 gateway, 3001 identity, 3002
# administration, 3003 organization, 3004 workspace) — lasciarle
# implicite qui è corretto, non una dimenticanza.
IDENTITY_SERVICE_URL=http://localhost:3001
ADMINISTRATION_SERVICE_URL=http://localhost:3002
ORGANIZATION_SERVICE_URL=http://localhost:3003
WORKSPACE_SERVICE_URL=http://localhost:3004
ONBOARDING_SERVICE_URL=http://localhost:3005

# ---------- Autenticazione (API Contract Modulo 2, sez. 2) ----------
JWT_SECRET=replace_with_a_real_secret_in_every_real_environment
# Feature 2.1 — autenticazione service-to-service. Deliberatamente
# distinto da JWT_SECRET: una fuga dell'uno non deve compromettere
# l'altro (i token di servizio e i token utente hanno scopi diversi).
SERVICE_JWT_SECRET=replace_with_a_different_real_secret_in_every_real_environment
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
OAUTH_ISSUER=http://localhost:3000

# ---------- AI Platform — Model Router (AI Platform Modulo 3, sez. 8) ----------
# Nessun modello specifico hardcoded qui: il Model Router legge la propria
# configurazione da un Model Registry (vedi ai-platform/model-router/README.md).
# Le chiavi API dei singoli provider di modelli vivono in un vault dedicato in
# produzione (Infrastructure Modulo 4, sez. 12.1), non in variabili d'ambiente
# in chiaro — questi valori servono solo per lo sviluppo locale.
MODEL_PROVIDER_PRIMARY_API_KEY=
MODEL_PROVIDER_FALLBACK_API_KEY=

# ---------- Vector Platform ----------
# In locale: pgvector (stessa istanza Postgres sopra). A scala: endpoint dedicato.
VECTOR_STORE_MODE=pgvector

# ---------- Osservabilità ----------
LOG_LEVEL=debug
OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# ---------- Feature flags per ambiente di sviluppo ----------
FEATURE_AI_AUTONOMY_DEFAULT_LEVEL=1
